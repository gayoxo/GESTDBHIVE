COMPOSE_PROJECT_NAME=gesdb
HIVE_VERSION=4.0.1
HUE_IMAGE_TAG=latest
FILEBROWSER_IMAGE_TAG=latest
# Rellenar con secretos NUEVOS. No publicar este archivo.
METASTORE_PASSWORD=CAMBIAR
DATA_POSTGRES_PASSWORD=CAMBIAR
HUE_POSTGRES_PASSWORD=CAMBIAR
MARIADB_ROOT_PASSWORD=CAMBIAR
MARIADB_USER_PASSWORD=CAMBIAR
# Usuario de solo lectura con el que Hive consulta MariaDB y PostgreSQL (JDBC)
OLIST_READER_USER=hive_reader
OLIST_READER_PASSWORD=CAMBIAR
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=CAMBIAR
HUE_SECRET_KEY=CAMBIAR_POR_CADENA_ALEATORIA_LARGA
# Administrador de Hue; se crea o actualiza en cada arranque de Hue
HUE_ADMIN_USER=admin
HUE_ADMIN_PASSWORD=CAMBIAR
# Administrador de File Browser (minimo 12 caracteres); se aplica en cada arranque
FILEBROWSER_ADMIN_USER=admin
FILEBROWSER_ADMIN_PASSWORD=CAMBIAR_MIN_12_CARACTERES
# Rutas relativas al docker-compose.yml de la raiz
WAREHOUSE_HOST_PATH=./warehouse
POSTGRES_JAR_HOST_PATH=./drivers/postgresql-42.7.4.jar
MARIADB_JAR_HOST_PATH=./drivers/mariadb-java-client-3.4.1.jar
DATASETS_HOST_PATH=./datasets
FILEBROWSER_UID=1000
FILEBROWSER_GID=1000
