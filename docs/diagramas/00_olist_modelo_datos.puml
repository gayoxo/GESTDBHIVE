@startuml 00_olist_modelo_datos
' Modelo de datos del dataset publico Olist (9 CSV de Kaggle).
' Las relaciones son logicas: los CSV no tienen claves declaradas.
' Fuente: https://www.kaggle.com/datasets/olistbr/brazilian-ecommerce
!theme plain
hide circle
skinparam linetype ortho
title Olist Brazilian E-Commerce — modelo de datos

entity "olist_orders_dataset" as orders {
  * order_id
  --
  customer_id
  order_status
  order_purchase_timestamp
  order_approved_at
  order_delivered_carrier_date
  order_delivered_customer_date
  order_estimated_delivery_date
}

entity "olist_order_items_dataset" as items {
  * order_id
  * order_item_id
  --
  product_id
  seller_id
  shipping_limit_date
  price
  freight_value
}

entity "olist_order_payments_dataset" as payments {
  * order_id
  * payment_sequential
  --
  payment_type
  payment_installments
  payment_value
}

entity "olist_order_reviews_dataset" as reviews {
  * review_id
  --
  order_id
  review_score
  review_comment_title
  review_comment_message
  review_creation_date
  review_answer_timestamp
}

entity "olist_customers_dataset" as customers {
  * customer_id
  --
  customer_unique_id
  customer_zip_code_prefix
  customer_city
  customer_state
}

entity "olist_sellers_dataset" as sellers {
  * seller_id
  --
  seller_zip_code_prefix
  seller_city
  seller_state
}

entity "olist_products_dataset" as products {
  * product_id
  --
  product_category_name
  product_name_lenght
  product_description_lenght
  product_photos_qty
  product_weight_g
  product_length_cm
  product_height_cm
  product_width_cm
}

entity "product_category_name_translation" as translation {
  * product_category_name
  --
  product_category_name_english
}

entity "olist_geolocation_dataset" as geo {
  geolocation_zip_code_prefix
  geolocation_lat
  geolocation_lng
  geolocation_city
  geolocation_state
}

customers ||--o{ orders : customer_id
orders ||--|{ items : order_id
orders ||--o{ payments : order_id
orders ||--o{ reviews : order_id
items }o--|| products : product_id
items }o--|| sellers : seller_id
products }o--o| translation : product_category_name
customers }o..o{ geo : zip_code_prefix
sellers }o..o{ geo : zip_code_prefix
@enduml
